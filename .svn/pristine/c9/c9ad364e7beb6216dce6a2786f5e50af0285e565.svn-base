<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no" name=viewport>
    <title>提现</title>
    <style>
        body,html{
            padding: 0;
            margin: 0;
            overflow: hidden;
            width: 100%;
            height: 100%;
            text-align: center;
            line-height: 100vh;
            font-size: 10vw;
        }
    </style>
</head>
<body>
	<#if result.success>
    	提现成功
    </#if>
    <#if !result.success>
    	提现失败，稍后重试
    </#if>
    
</body>
</html>

