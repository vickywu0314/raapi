package com.car.jl.controller;

import java.text.SimpleDateFormat;
import java.util.Calendar;
import java.util.Date;
import java.util.HashMap;
import java.util.Map;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.web.bind.annotation.CrossOrigin;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;
import com.car.jl.mapper.UserMapper;
import com.car.jl.util.CommonUtil;
import com.car.jl.vo.DataResult;
import com.itextpdf.text.pdf.PdfStructTreeController.returnType;
import com.yunpian.sdk.YunpianClient;
import com.yunpian.sdk.model.Result;
import com.yunpian.sdk.model.SmsSingleSend;

import io.swagger.annotations.Api;
import io.swagger.annotations.ApiOperation;
import io.swagger.annotations.ApiParam;
import net.sf.json.JSONObject;

@Api(description = "获取登陆注册验证码")
@CrossOrigin
@RestController
@RequestMapping(value="/yp")
public class YpController {

	@Value("${yp_appkey}")
	private String yp_appkey;
	
	@ApiOperation(value = "获取验证码", notes = "获取验证码" ,response=DataResult.class,httpMethod = "GET")
	@GetMapping("/code/{phone}")
	public Map<String, Object> code(HttpServletRequest request,HttpServletResponse response,
			@ApiParam(value = "手机号",required = true) @PathVariable String phone) {
		Map<String, Object> result = new HashMap<String, Object>();
		try {
			YunpianClient clnt = new YunpianClient(yp_appkey).init();
			String smcodeString = CommonUtil.generateCode();
			//发送短信API
			Map<String, String> param = clnt.newParam(1);
			param.put(YunpianClient.MOBILE, phone);
			param.put(YunpianClient.TEXT, "【乾行数】您的验证码是"+smcodeString+"。如非本人操作，请忽略本短信");
			Result<SmsSingleSend> r = clnt.sms().single_send(param);
			System.out.println(r.toString());
			if(r.getCode()==0) {
				result.put("success",true);
				result.put("code",smcodeString);
				result.put("phone",phone);
				result.put("message", "成功获取验证码");
			}else {
				result.put("success",false);
				result.put("code","");
				result.put("phone",phone);
				result.put("message", r.getMsg());
			} 
			clnt.close() ;
		}catch(Exception e) {
			e.printStackTrace();
			result.put("success",false);
			result.put("code","");
			result.put("phone",phone);
			result.put("message", "验证码获取失败稍后再试");
		}
		return result;
	}
	
}
