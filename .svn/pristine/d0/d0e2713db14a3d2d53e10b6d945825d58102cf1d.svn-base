package com.car.jl.controller;

import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.web.bind.annotation.CrossOrigin;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;
import com.car.jl.mapper.UserMapper;
import com.car.jl.vo.DataResult;
import com.sun.org.apache.bcel.internal.generic.NEW;

import io.swagger.annotations.Api;
import io.swagger.annotations.ApiOperation;
import io.swagger.annotations.ApiParam;

@Api(description = "用户模块")
@CrossOrigin
@RestController
@RequestMapping(value="/user")
public class UserController {
	
	@Value("${cashValue}")
	private double cashValue;
	@Value("${last_day}")
	private String last_day;
	@Value("${dayInterval}")
	private int dayInterval;
	@Value("${jl_checkuser}")
	private String jl_checkuser;
	@Value("${yyl_uid}")
	private String yyl_uid;
	@Value("${yyl_checkuser}")
	private String yyl_checkuser;
	@Autowired
	private UserMapper userMapper;
	private SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd");

	@ApiOperation(value = "用户首页", notes = "用户首页" ,response=DataResult.class,httpMethod = "POST")
	@PostMapping("/index")
	public DataResult<List<Map<String, Object>>> index(
			@RequestParam(value = "id", required = true) @ApiParam(value = "用户id",required = true) Long id,
			HttpServletRequest request) {
		DataResult<List<Map<String, Object>>> result = new DataResult<List<Map<String, Object>>>();
		try {
			List<Map<String, Object>> userList = userMapper.getUserMainPage(id);
			result.setCode("200");
			result.setData(userList);
			result.setMessage("成功");
			result.setSuccess(true);
		}catch(Exception e) {
			result.setCode("500");
			result.setMessage("参数错误获取失败");
			result.setSuccess(false);
		}
		return result;
	}
	
	@ApiOperation(value = "签到领取红包", notes = "签到领红包" ,response=DataResult.class,httpMethod = "POST")
	@PostMapping("/getMoney")
	public DataResult<Map<String, Object>> getMoney(
			@RequestParam(value = "id", required = true) @ApiParam(value = "用户id",required = true) Long id,
			HttpServletRequest request) {
		DataResult<Map<String, Object>> result = new DataResult<Map<String, Object>>();
		try {
			String today = sdf.format(new Date()); 
			List<Map<String, Object>> moneyHis = userMapper.getUserMoneyRecord(id);
			Map<String, Object> map = new HashMap<String,Object>();
			if(null!=moneyHis && moneyHis.size()>0) {
				for(Map<String, Object> m:moneyHis) {
					if(m.get("date").toString().equals(today)){
						result.setCode("200");
						result.setData(null);
						result.setMessage("今日已签到领取红包，明天再来");
						result.setSuccess(true);
						return result;
					}
				}
				map.put("id",id);
				if((moneyHis.size()+1)%7 != 0) {
					map.put("money",((moneyHis.size()+1)%7) * 0.5);
				}else{
					map.put("money",7);
				}
				map.put("type",1);
				userMapper.saveUserMoney(map);
			}else {
				map.put("id",id);
				map.put("money",0.5);
				map.put("type",1);
				userMapper.saveUserMoney(map);
			}
			double total = userMapper.getTotalMoney(id);
			map.put("total",total);
			result.setCode("200");
			result.setData(map);
			result.setMessage("成功");
			result.setSuccess(true);
		}catch(Exception e) {
			result.setCode("500");
			result.setMessage("参数错误获取失败");
			result.setSuccess(false);
			e.printStackTrace();
		}
		return result;
	}
	
	@ApiOperation(value = "查看排行榜", notes = "查看排行榜" ,response=DataResult.class,httpMethod = "POST")
	@PostMapping("/getRank")
	public DataResult<List<Map<String,Object>>> getRank(HttpServletRequest request) {
		DataResult<List<Map<String,Object>>> result = new DataResult<List<Map<String,Object>>>();
		try {
			Map<String, Object> map = new HashMap<String,Object>();
			List<Map<String,Object>> rankList = userMapper.getRank();
			if(null!=rankList && rankList.size()!=0) {
				for(Map<String, Object> m : rankList) {
					long uid = Long.parseLong(m.get("id").toString());
					List<Map<String,Object>> mediaList = userMapper.getUserMediaById(uid);
					if(null!=mediaList) {
						boolean f1=false,f2=false;
						for(Map<String, Object> mm:mediaList) {
							if(Integer.parseInt(mm.get("type").toString())==3) {
								m.put("cover",mm.get("url").toString());
								f1=true;
							}else if(Integer.parseInt(mm.get("type").toString())==4) {
								m.put("douYinCode",mm.get("url").toString());
								f2=true;
							}
						}
						if(!f1) {
							m.put("cover","");
						}
						if(!f2) {
							m.put("douYinCode","");
						}
					}else {
						m.put("cover","");
						m.put("douYinCode","");
					}
				}
			}
			result.setCode("200");
			result.setData(rankList);
			result.setMessage("成功");
			result.setSuccess(true);
		}catch(Exception e) {
			result.setCode("500");
			result.setMessage("参数错误获取失败");
			result.setSuccess(false);
			e.printStackTrace();
		}
		return result;
	}
	
	@ApiOperation(value = "视频点赞", notes = "视频点赞" ,response=DataResult.class,httpMethod = "POST")
	@PostMapping("/addFavorite")
	public DataResult<List<Map<String, Object>>> addFavorite(
			@RequestParam(value = "vid", required = true) @ApiParam(value = "视频id",required = true) Long vid,
			@RequestParam(value = "uid", required = true) @ApiParam(value = "用户id",required = true) Long uid,
			HttpServletRequest request) {
		DataResult<List<Map<String, Object>>> result = new DataResult<List<Map<String, Object>>>();
		try {
			userMapper.addFavorite(vid);
			List<Map<String, Object>> userList = userMapper.getUserMainPage(uid);
			result.setCode("200");
			result.setData(userList);
			result.setMessage("成功");
			result.setSuccess(true);
		}catch(Exception e) {
			result.setCode("500");
			result.setMessage("参数错误获取失败");
			result.setSuccess(false);
		}
		return result;
	}
	
	@ApiOperation(value = "红包提现校验是否符合提现条件", notes = "红包提现校验是否符合提现条件" ,response=DataResult.class,httpMethod = "POST")
	@PostMapping("/getCashOrNot")
	public DataResult<Map<String, Object>> getCashOrNot(
			@RequestParam(value = "id", required = true) @ApiParam(value = "用户id",required = true) Long id,
			HttpServletRequest request,HttpServletResponse response) {
		DataResult<Map<String, Object>> result = new DataResult<Map<String, Object>>();
		String info = "提现要求金额大于"+cashValue+"或距离活动结束"+dayInterval+"天内，继续加油!";
		Map<String, Object> m = new HashMap<String, Object>();
		String url = "";
		try {
			double total = userMapper.getTotalMoney(id);
			SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd");
			Date day1 = sdf.parse(sdf.format(new Date()));
			Date day2 = sdf.parse(last_day);
			long interval = (day2.getTime()-day1.getTime())/(24*60*60*1000);
			System.out.println("total==="+total+"------interval===="+interval);
			if(interval<=dayInterval || total>=cashValue) {
				info="符合提现要求";
				url=yyl_checkuser+"?uid="+yyl_uid+"&url="+jl_checkuser+id+"&flag=0";
				m.put("flag",true);
			}else {
				m.put("flag",false);
			}
			m.put("url",url);
			result.setCode("200");
			result.setData(m);
			result.setMessage(info);
			result.setSuccess(true);
		}catch(Exception e) {
			result.setCode("500");
			result.setMessage("参数错误获取失败");
			result.setSuccess(false);
		}
		return result;
	}
}
