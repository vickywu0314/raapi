    /**
     * 写入文件
     *
     * @param fileItem
     * @param request
     * @param fileKey
     * @return
     * @throws Exception
     */
    private File uploadFile(MultipartFile fileItem, HttpServletRequest request, Integer fileType) throws Exception {
        // 判断文件是否存在
        if (fileItem == null || fileItem.isEmpty()) {
            return null;
        }
        try {
            String fileName = fileItem.getOriginalFilename();
            String s = UUID.randomUUID().toString();
            String desPath = UPLOAD_PATH;
            createFolder(desPath);
            int index = fileName.lastIndexOf(".");
            //取得文件扩展名
            String extendName = fileName.substring(index);
            fileName = s + extendName;
            String path = desPath + fileName;
            File localFile = new File(path);
            fileItem.transferTo(localFile);
            return localFile;
        } catch (Exception e) {
            e.printStackTrace();
            return null;
        }
    }
    
    private File uploadFile(MultipartFile fileItem, HttpServletRequest request) throws Exception {
        // 判断文件是否存在
        if (fileItem == null || fileItem.isEmpty()) {
            return null;
        }
        try {
            String fileName = fileItem.getOriginalFilename();
            String s = UUID.randomUUID().toString();
            String desPath = UPLOAD_PATH;
            createFolder(desPath);
            int index = fileName.lastIndexOf(".");
            //取得文件扩展名
            String extendName = fileName.substring(index);
            fileName = s + extendName;
            String path = desPath + fileName;
            File localFile = new File(path);
            fileItem.transferTo(localFile);
            return localFile;
        } catch (Exception e) {
            e.printStackTrace();
            return null;
        }
    }

    /**
     * 创建文件夹
     *
     * @param dir
     * @return
     */
    private boolean createFolder(String dir) {
        File file = new File(dir);
        if (file.isDirectory()) {
            return true;
            // 存在时空处理
        } else {
            return file.mkdirs();
        }
    }
    
    private String cdnUp(MultipartFile fileItem) {
        String fileName = fileItem.getOriginalFilename();
        String s = UUID.randomUUID().toString();
        int index = fileName.lastIndexOf(".");
        //取得文件扩展名
        String extendName = fileName.substring(index);
        fileName = s + extendName;
        System.out.println("cdn upload fileName==========="+fileName);
        
    	//构造一个带指定 Region 对象的配置类
    	Configuration cfg = new Configuration(Region.region0());
    	UploadManager uploadManager = new UploadManager(cfg);
    	//默认不指定key的情况下，以文件内容的hash值作为文件名
    	String key = fileName;
    	try {
    	    Auth auth = Auth.create(AK,SK);
    	    String upToken = auth.uploadToken(BUCKET);
    	    try {
    	        Response response = uploadManager.put(fileItem.getInputStream(),key,upToken,null, null);
    	        DefaultPutRet putRet = new Gson().fromJson(response.bodyString(), DefaultPutRet.class);
    	        System.out.println(putRet.key);
    	        System.out.println(putRet.hash);
    	        if(null!=putRet.key && putRet.key.equals(key) && null!=putRet.hash) {
    	        	return fileName;
    	        }else {
    	        	return null;
    	        }
    	    } catch (QiniuException ex) {
    	        Response r = ex.response;
    	        System.out.println(r.toString());
    	        try {
    	            System.out.println(r.bodyString());
    	        } catch (QiniuException ex2) {
    	            //ignore
    	        }
    	        return null;
    	    }
    	} catch (Exception ex) {
    		ex.printStackTrace();
    	    return null;
    	}
    }

    @ApiOperation(value = "上传", notes = "上传" ,response=DataResult.class,httpMethod = "POST")
    @CrossOrigin
    @PostMapping("/todo")
    public DataResult<JSONObject> upload(HttpServletRequest request,HttpSession session, HttpServletResponse response,
            @RequestParam(value = "file", required = true) @ApiParam(value = "图片or视频文件",required = true) MultipartFile file,
            @RequestParam(value = "fileType", required = true) @ApiParam(value = "格式，1-图片，2-视频",required = true) int fileType) {
        DataResult<JSONObject> result = new DataResult<JSONObject>();
        try {
            if (file != null) {
              JSONObject node = new JSONObject();
                String oldName = file.getOriginalFilename();
                int index = oldName.lastIndexOf(".");
                //取得文件扩展名
                String extendName = oldName.substring(index);
//                //上传图片
//                BufferedImage bufferedImg = ImageIO.read(file.getInputStream());
//                File localFile = uploadFile(file,request,fileType);
//                String  fileName = localFile.getName();
//                String fileUrl = URL_PATH;
//                fileUrl += fileName;
            	String fileName = cdnUp(file);
            	String fileUrl = CDN_URL_PATH+fileName;
                node.put("fileType", fileType);
                node.put("oldName", oldName);
                node.put("extendName", extendName);
                node.put("fileName", fileName);
                node.put("fileUrl", fileUrl);
                result.setData(node);
                result.setCode("200");
                result.setSuccess(true);
                result.setMessage("请求成功!");
            }else {
            	result.setData(null);
            	result.setCode("500");
            	result.setSuccess(false);
            	result.setMessage("上传格式或参数不符合要求!");
            }
        } catch (Exception e) {
        	e.printStackTrace();
        	result.setCode("500");
        	result.setSuccess(false);
        	result.setMessage("请求异常!");
        }
        return result;
    }

    
    @ApiOperation(value = "保存上传", notes = "保存上传" ,response=DataResult.class,httpMethod = "POST")
    @PostMapping("/save")
    public DataResult<Object> save(HttpServletRequest request,HttpSession session, HttpServletResponse response,
    		@RequestParam(value = "id", required = true) @ApiParam(value = "用户id",required = true) Long id,
    		@RequestParam(value = "fileUrls", required = true) @ApiParam(value = "已上传视频的地址",required = true) List<String> fileUrls,
    		@RequestParam(value = "picCover", required = true) @ApiParam(value = "已上传图片封面地址",required = true) String picCover,
    		@RequestParam(value = "douYinCode", required = false) @ApiParam(value = "已上传抖音二维码地址",required = false) String douYinCode) {
        DataResult<Object> result = new DataResult<Object>();
        List<UserMedia> umList = new ArrayList<UserMedia>();
        Map<String, Object> u = new HashMap<String,Object>();
        try {
        	if(null==id||id==0) {
        		result.setCode("500");
            	result.setSuccess(false);
            	result.setMessage("请先登陆再上传");
            	return result;
        	}
        	if(null!=picCover && picCover.length()>0) {
        		UserMedia um1 = new UserMedia();
            	um1.setUser_id(id);
            	um1.setUrl(picCover);
                um1.setType(3);
                umList.add(um1);
        	}
        	if(null!=douYinCode && douYinCode.length()>0) {
        		 UserMedia um2 = new UserMedia();
                 um2.setUser_id(id);
                 um2.setUrl(douYinCode);
                 um2.setType(4);
                 umList.add(um2);
        	}
            if(null!=fileUrls && fileUrls.size()>0) {
            	for (String url: fileUrls) {
                	String[] split = url.split("/");
        			String sourceName = split[split.length-1];
        			File sourceFile = new File(UPLOAD_PATH+sourceName);
        			if(sourceFile.exists()) {
        				UserMedia um = new UserMedia();
        				um.setUser_id(id);
        	            um.setUrl(url);
        	            um.setType(2);
        	            String nameStr = UUID.randomUUID().toString()+".jpg";
        	            videoText.getTempPath(UPLOAD_PATH+nameStr, UPLOAD_PATH+sourceName);
        	            um.setCover(URL_PATH+nameStr);
        	            umList.add(um);
        			}
                }
            }
            
            loginMapper.saveUserMedia(umList);
            User user = loginMapper.getUserById(id);
            u.put("id",id);
            u.put("name",user.getName());
            u.put("code",douYinCode);
            u.put("invitation_code",user.getInvitation_code());
            result.setData(u);
            result.setCode("200");
            result.setSuccess(true);
            result.setMessage("请求成功!");
        } catch (Exception e) {
        	e.printStackTrace(); 
        	result.setCode("500");
        	result.setSuccess(false);
        	result.setMessage("请求异常!");
        }
        return result;
    }

    
    
    
    @ApiOperation(value = "保存并上传", notes = "保存并上传" ,response=DataResult.class,httpMethod = "POST")
    @PostMapping("/save2")
    public DataResult<Object> save2(HttpServletRequest request,HttpSession session, HttpServletResponse response,
    		@RequestParam(value = "id", required = true) @ApiParam(value = "用户id",required = true) Long id,
    		@RequestParam(value = "filePic", required = true) @ApiParam(value = "封面",required = true) MultipartFile filePic,
    		@RequestParam(value = "fileCode", required = true) @ApiParam(value = "二维码",required = true) MultipartFile fileCode,
    		@RequestParam(value = "fileVedio", required = true) @ApiParam(value = "视频",required = true) MultipartFile fileVedio) {
        DataResult<Object> result = new DataResult<Object>();
        List<UserMedia> umList = new ArrayList<UserMedia>();
        Map<String, Object> u = new HashMap<String,Object>();
        try {
        	if (null!=filePic && null!=fileCode && null!=fileVedio && id>0) {
        		
                File localFilePic = uploadFile(filePic,request);
                String  fileNamePic = localFilePic.getName();
                String filePicUrl = URL_PATH+fileNamePic;
                
                File localFileCode = uploadFile(fileCode,request);
                String  fileNameCode = localFileCode.getName();
                String fileCodeUrl = URL_PATH+fileNameCode;
               
                
                File localFileVedio= uploadFile(fileVedio,request);
                String  fileNameVedio = localFileVedio.getName();
                String fileVedioUrl = URL_PATH+fileNameVedio;
                
                
                UserMedia um = new UserMedia();
            	um.setUser_id(id);
            	
            	um.setUrl(filePicUrl);
                um.setType(3);
                umList.add(um);
                
                um.setUrl(fileCodeUrl);
                um.setType(4);
                umList.add(um);
                
                um.setUrl(fileVedioUrl);
	            um.setType(2);
	            umList.add(um);
	            
                loginMapper.saveUserMedia(umList);
                User user = loginMapper.getUserById(id);
                u.put("id",id);
                u.put("name",user.getName());
                u.put("code",fileCodeUrl);
                u.put("invitation_code",user.getInvitation_code());
                result.setData(u);
                result.setCode("200");
                result.setSuccess(true);
                result.setMessage("请求成功!");
                return result;
            }else {
            	result.setCode("500");
            	result.setSuccess(false);
            	result.setMessage("参数错误请求异常!");
            	return result;
            }
        } catch (Exception e) {
        	e.printStackTrace();
        	result.setCode("500");
        	result.setSuccess(false);
        	result.setMessage("请求异常!");
        }
        return result;
    }
    
    
    @ApiOperation(value = "删除已上传图片or视频", notes = "删除已上传图片or视频" ,response=DataResult.class,httpMethod = "POST")
    @PostMapping("/del")
	public DataResult<Object> del(HttpServletRequest request,
			@RequestParam(value = "fileUrl", required = true) @ApiParam(value = "要删除图片或视频的地址",required = true) String fileUrl,
			@RequestParam(value = "id", required = true) @ApiParam(value = "用户id",required = true) Long id,
			HttpSession session, HttpServletResponse response) {
    	DataResult<Object> result = new DataResult<Object>();
    	try {
    		if(StringUtils.isBlank(fileUrl)) {
    			result.setCode("500");
    			result.setSuccess(false);
    			result.setMessage("选择要删除的文件");
    			return result;
    		}else if(null==id || id==0) {
    			result.setCode("500");
    			result.setSuccess(false);
    			result.setMessage("请先登陆再操作");
    			return result;
    		}
			String[] split = fileUrl.split("/");
			String sourceName = split[split.length-1];
			//源文件路径
			File sourceFile = new File(UPLOAD_PATH+sourceName);
			sourceFile.delete();
			UserMedia um = new UserMedia();
            um.setUser_id(id);
            um.setUrl(fileUrl);
            loginMapper.delUserMedia(um);
			result.setCode("200");
			result.setSuccess(true);
			result.setMessage("请求成功!");
    	} catch (Exception e) {
    		e.printStackTrace();
    		result.setCode("500");
    		result.setSuccess(false);
    		result.setMessage("请求异常!");
    	}
    	return result;
	}
}
