package com.car.jl.controller;

import java.text.SimpleDateFormat;
import java.util.Calendar;
import java.util.Date;
import java.util.HashMap;
import java.util.Map;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.CrossOrigin;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;
import com.car.jl.mapper.UserMapper;
import com.car.jl.util.CommonUtil;
import com.itextpdf.text.pdf.PdfStructTreeController.returnType;

import net.sf.json.JSONObject;


@CrossOrigin
@Controller
@RequestMapping(value="/yyl")
public class YylController {

	@Autowired
	private UserMapper userMapper;
	@Value("${cashValue}")
	private double cashValue;
	@Value("${last_day}")
	private String last_day;
	@Value("${dayInterval}")
	private int dayInterval;
	@Value("${yyl_cash}")
	private String yyl_cash;
	@Value("${yyl_uid}")
	private String yyl_uid;
	@Value("${yyl_appkey}")
	private String yyl_appkey;
	
	public static final String APPLICATION_JSON = "application/json";
	public static final String TEXT_XML="text/xml";

	@GetMapping("/user/{id}")
	public String getUserinfo(HttpServletRequest request,HttpServletResponse response,@PathVariable Long id) {
		System.out.println("ivtick--------====="+request.getParameter("ivtick"));
		System.out.println("u_openid--------====="+request.getParameter("u_openid"));
		System.out.println("encdata--------====="+request.getParameter("encdata"));
		System.out.println("userinfo--------====="+request.getParameter("userinfo"));
		System.out.println("uid--------====="+id);
		Map<String,Object> result = new HashMap<String,Object>();
		try {
			if(null!=id && null!=request.getParameter("u_openid")) {
				String openid = request.getParameter("u_openid").toString();
				double total = userMapper.getTotalMoney(id);
				SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd");
				Date day1 = sdf.parse(sdf.format(new Date()));
				Date day2 = sdf.parse(last_day);
				long interval = (day2.getTime()-day1.getTime())/(24*60*60*1000);
				if(interval<=dayInterval || total>=cashValue) {
					System.out.println("ok============");
					String orderid = CommonUtil.generateShortUuid(8);
					long time = Calendar.getInstance().getTimeInMillis()/1000;
					int m2 = (int)(total*100);
					StringBuffer sb = new StringBuffer();
					sb.append(yyl_uid).append(0).append(orderid).append(m2).
					append(time).append(openid).append(yyl_appkey);
					String sign = CommonUtil.md5(sb.toString());
					System.out.println("sb==="+sb.toString());
					System.out.println("sign======"+sign);
					String url = yyl_cash+"?uid="+yyl_uid+"&type=0&money="+
					m2+"&orderid="+orderid+"&reqtick="+time+
					"&openid="+openid+"&title=JMC&sendname=JMC&wishing=JMC&sign="+sign;
					
					System.out.println(url);
					String res = CommonUtil.sendToUrl("",url,"utf-8",50,APPLICATION_JSON);
					System.out.println(res);
					JSONObject obj = JSONObject.fromObject(res);
					if(null!=obj && obj.size()>0) {
						if(obj.get("errcode").toString().equals("0") && 
							obj.get("retmsg").toString().equals("发放成功")) {
							Map<String, Object> map = new HashMap<String,Object>();
							map.put("id",id);
							map.put("money",-total);
							map.put("type",2);
							userMapper.saveUserMoney(map);
						}
						result.put("success",true);
						result.put("code",200);
						result.put("message","成功领取");
					}else {
						result.put("success",false);
						result.put("code",500);
						result.put("message","服务异常，稍后重试");
					}
				}else {
					result.put("success",false);
					result.put("code",500);
					result.put("message","总金额不足"+cashValue+"元不能领取");
				}
			}else {
				result.put("success",false);
				result.put("code",500);
				result.put("message","获取用户信息失败");
			}
		}catch(Exception e) {
			e.printStackTrace();
			result.put("success",false);
			result.put("code",500);
			result.put("message","获取用户信息失败");
		}
		request.setAttribute("result", result);
		return "result";
	}
	
}
