	@ApiOperation(value = "红包提现校验是否符合提现条件", notes = "红包提现校验是否符合提现条件" ,response=DataResult.class,httpMethod = "POST")
	@PostMapping("/getCashOrNot")
	public DataResult<Map<String, Object>> getCashOrNot(
			@RequestParam(value = "id", required = true) @ApiParam(value = "用户id",required = true) Long id,
			HttpServletRequest request,HttpServletResponse response) {
		DataResult<Map<String, Object>> result = new DataResult<Map<String, Object>>();
		String info = "提现要求金额大于"+cashValue+"元,才可提现!";
		Map<String, Object> m = new HashMap<String, Object>();
		String url = "";
		try {
			if(null==id || id==0) {
				result.setCode("500");
				result.setData(null);
				result.setMessage("请先登陆后再操作");
				result.setSuccess(false);
				return result;
			}
			double total = userMapper.getTotalMoney(id);
//			SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd");
//			Date day1 = sdf.parse(sdf.format(new Date()));
//			Date day2 = sdf.parse(last_day);
//			long interval = (day2.getTime()-day1.getTime())/(24*60*60*1000);
//			System.out.println("total==="+total+"------interval===="+interval);
//			if(interval<=dayInterval || total>=cashValue) {
			if(total>=cashValue) {
				info="符合提现要求";
				url=yyl_checkuser+"?uid="+yyl_uid+"&url="+jl_checkuser+id+"&flag=0";
				m.put("flag",true);
			}else {
				m.put("flag",false);
			}
			m.put("url",url);
			result.setCode("200");
			result.setData(m);
			result.setMessage(info);
			result.setSuccess(true);
		}catch(Exception e) {
			result.setCode("500");
			result.setMessage("参数错误获取失败");
			result.setSuccess(false);
		}
		return result;
	}
	
