	@ApiOperation(value = "查看排行榜", notes = "查看排行榜" ,response=DataResult.class,httpMethod = "POST")
	@PostMapping("/getRank")
	//@RequestParam(value = "industry", required = true) @ApiParam(value = "所属行业",required = true) String industry,
	public DataResult<List<Map<String,Object>>> getRank(HttpServletRequest request) {
		DataResult<List<Map<String,Object>>> result = new DataResult<List<Map<String,Object>>>();
		try {
			Map<String, Object> map = new HashMap<String,Object>();
			List<Map<String,Object>> rankList = userMapper.getRank();
			Map<String,List<Map<String,Object>>> resultMap = new HashMap<String, List<Map<String,Object>>>();
			if(null!=rankList && rankList.size()!=0) {
				// 之前的逻辑
//				for(Map<String, Object> m : rankList) {
//					long uid = Long.parseLong(m.get("user_id").toString());
//					List<Map<String,Object>> mediaList = userMapper.getUserMediaById(uid);
//					if(null!=mediaList) {
//						boolean f1=false,f2=false;
//						for(Map<String, Object> mm:mediaList) {
//							if(Integer.parseInt(mm.get("type").toString())==3) {
//								m.put("cover",mm.get("url").toString());
//								f1=true;
//							}else if(Integer.parseInt(mm.get("type").toString())==4) {
//								m.put("douYinCode",mm.get("url").toString());
//								f2=true;
//							}
//						}
//						if(!f1) {
//							m.put("cover","");
//						}
//						if(!f2) {
//							m.put("douYinCode","");
//						}
//					}else {
//						m.put("cover","");
//						m.put("douYinCode","");
//					}
//				}
				
				int gsbt = 0 ;
				int bjbz = 0 ;
				int llzl = 0 ;
				int wjjczm = 0;
				int wlmz = 0 ;
			
				
				List<Map<String,Object>> gsbtList = new ArrayList<Map<String,Object>>();
				List<Map<String,Object>> bjbzList = new ArrayList<Map<String,Object>>();
				List<Map<String,Object>> llzlList = new ArrayList<Map<String,Object>>();
				List<Map<String,Object>> wjjczmList = new ArrayList<Map<String,Object>>();
				List<Map<String,Object>> wlmzList = new ArrayList<Map<String,Object>>();
				
				//只拿每个行业的前三个，我本来是想偷懒，结果 宇航比我还懒； 
				for(Map<String, Object> m : rankList) {
					String indu = (String)m.get("industry");
					if(indu != null && !"".equals(indu) && "果蔬镖头".equals(indu) && gsbt < 3)
					{
						if(resultMap.get("果蔬镖头") != null)	
						{
							gsbtList = (ArrayList<Map<String,Object>>)resultMap.get("果蔬镖头"); 
						}
						m.put("rownum", gsbtList.size()+1);
						gsbtList.add(m);
						gsbt++;
						resultMap.put("果蔬镖头",gsbtList);
					}
					if(indu != null && !"".equals(indu) && "搬家帮主".equals(indu) && bjbz < 3)
					{
						if(resultMap.get("搬家帮主") != null)
						{
							bjbzList = (ArrayList<Map<String,Object>>)resultMap.get("搬家帮主"); 
						}
						m.put("rownum", bjbzList.size()+1);
						bjbzList.add(m);
						bjbz++;
						resultMap.put("搬家帮主",bjbzList);
					}
					if(indu != null && !"".equals(indu) && "冷链长老".equals(indu) && llzl < 3)
					{
						if(resultMap.get("冷链长老") != null)
						{
							llzlList = (ArrayList<Map<String,Object>>)resultMap.get("冷链长老"); 
						}
						m.put("rownum", llzlList.size()+1);
						llzlList.add(m);
						llzl++;
						resultMap.put("冷链长老",llzlList);
					}
					if(indu != null && !"".equals(indu) && "五金建材掌门".equals(indu) && wjjczm < 3)
					{
						if(resultMap.get("五金建材掌门") != null)
						{
							wjjczmList = (ArrayList<Map<String,Object>>)resultMap.get("五金建材掌门"); 
						}
						m.put("rownum", wjjczmList.size()+1);
						wjjczmList.add(m);
						wjjczm++;
						resultMap.put("五金建材掌门",wjjczmList);
					}
					if(indu != null && !"".equals(indu) && "物流盟主".equals(indu) && wlmz < 3)
					{
						if(resultMap.get("物流盟主") != null)
						{
							wlmzList = (ArrayList<Map<String,Object>>)resultMap.get("物流盟主"); 
						}
						m.put("rownum", wlmzList.size()+1);
						wlmzList.add(m);
						wlmz++;
						resultMap.put("物流盟主",wlmzList);
					}
				}
			}
			result.setCode("200");
			result.setDataMap(resultMap);
			result.setMessage("成功");
			result.setSuccess(true);
		}catch(Exception e) {
			result.setCode("500");
			result.setMessage("参数错误获取失败");
			result.setSuccess(false);
			e.printStackTrace();
		}
		return result;
	}
	
	@ApiOperation(value = "查看某个类别下的所有排行榜", notes = "查看某个类别下的所有排行榜" ,response=DataResult.class,httpMethod = "POST")
	@PostMapping("/getRankByIndustry")
	public DataResult<List<Map<String,Object>>> getRankByIndustry(@RequestParam(value = "industry", required = true) @ApiParam(value = "所属行业",required = true) String industry,HttpServletRequest request) {
		DataResult<List<Map<String,Object>>> result = new DataResult<List<Map<String,Object>>>();
		try {
			Map<String, Object> map = new HashMap<String,Object>();
			map.put("industry",industry);
			List<Map<String,Object>> rankList = userMapper.getRankByIndustry(map);
			if(null!=rankList && rankList.size()!=0) {
				// 之前的逻辑
				int i=1;
				for(Map<String, Object> m : rankList) {
					m.put("rownum",i);
					i++;
					long uid = Long.parseLong(m.get("user_id").toString());
					List<Map<String,Object>> mediaList = userMapper.getUserMediaById(uid);
					if(null!=mediaList) {
						boolean f1=false,f2=false;
						for(Map<String, Object> mm:mediaList) {
							if(Integer.parseInt(mm.get("type").toString())==3) {
								m.put("cover",mm.get("url").toString());
								f1=true;
							}else if(Integer.parseInt(mm.get("type").toString())==4) {
								m.put("douYinCode",mm.get("url").toString());
								f2=true;
							}
						}
						if(!f1) {
							m.put("cover","");
						}
						if(!f2) {
							m.put("douYinCode","");
						}
					}else {
						m.put("cover","");
						m.put("douYinCode","");
					}
				}
			}
			result.setCode("200");
			result.setData(rankList);
			result.setMessage("成功");
			result.setSuccess(true);
		}catch(Exception e) {
			result.setCode("500");
			result.setMessage("参数错误获取失败");
			result.setSuccess(false);
			e.printStackTrace();
		}
		return result;
	}
	
	@ApiOperation(value = "视频点赞", notes = "视频点赞" ,response=DataResult.class,httpMethod = "POST")
	@PostMapping("/addFavorite")
	public DataResult<List<Map<String, Object>>> addFavorite(
			@RequestParam(value = "vid", required = true) @ApiParam(value = "视频id",required = true) Long vid,
			@RequestParam(value = "uid", required = true) @ApiParam(value = "用户id",required = true) Long uid,
			HttpServletRequest request) {
		DataResult<List<Map<String, Object>>> result = new DataResult<List<Map<String, Object>>>();
		try {
			if(null!=vid && null!=uid && vid>0 && uid>0) {
				User u = loginMapper.getUserById(uid);	
				Map<String, Object> video = userMapper.getMediaById(vid);
				if(null!=video && Long.parseLong(video.get("id").toString())>0) {
					if(null!=u && u.getId()>0) {
						Map<String, Object> m = new HashMap<String, Object>();
						m.put("vid",vid);
						m.put("uid",uid);			//不管是游客 还是已注册用户，uid可以直接使用   游客的UID，生成规则 大于10000
						long count = userMapper.getFavCountByUMid(m);
						if(count<10) {
							userMapper.addFavorite(vid);
							userMapper.saveFavCount(m);
							List<Map<String, Object>> userList = userMapper.getUserMainPage(uid);
							result.setCode("200");
							result.setData(userList);
							result.setMessage("成功");
							result.setSuccess(true);
						}else {
							result.setCode("500");
							result.setMessage("该视频今日已点赞10次，明天再来");
							result.setSuccess(false);
						}
					}else {
						result.setCode("200");
						result.setMessage("成功");
						result.setSuccess(true);
					}
				}else {
					result.setCode("500");
					result.setMessage("用户或视频不存在");
					result.setSuccess(false);
				}
			}else {
				result.setCode("500");
				result.setMessage("参数错误");
				result.setSuccess(false);
			}
		}catch(Exception e) {
			result.setCode("500");
			result.setMessage("参数错误获取失败");
			result.setSuccess(false);
			e.printStackTrace();
		}
		return result;
	}
	
