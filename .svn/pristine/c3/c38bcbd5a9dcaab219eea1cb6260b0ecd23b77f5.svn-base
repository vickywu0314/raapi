	@ApiOperation(value = "用户首页", notes = "用户首页" ,response=DataResult.class,httpMethod = "POST")
	@PostMapping("/index")
	public DataResult<List<Map<String, Object>>> index(
			@RequestParam(value = "id", required = true) @ApiParam(value = "用户id",required = true) Long id,
			HttpServletRequest request) {
		DataResult<List<Map<String, Object>>> result = new DataResult<List<Map<String, Object>>>();
		try {
			List<Map<String, Object>> userList = userMapper.getUserMainPage(id);
			result.setCode("200");
			result.setData(userList);
			result.setMessage("成功");
			result.setSuccess(true);
		}catch(Exception e) {
			result.setCode("500");
			result.setMessage("参数错误获取失败");
			result.setSuccess(false);
		}
		return result;
	}
	
	@ApiOperation(value = "用户视频列表加上查看更多", notes = "用户视频列表加上查看更多" ,response=DataResult.class,httpMethod = "POST")
	@PostMapping("/getMoreVideosFromUser")
	public DataResult<Map<String,List<Map<String, Object>>>> getMoreVideosFromUser(
			@RequestParam(value = "id", required = true) @ApiParam(value = "用户id",required = true) Long id,
			HttpServletRequest request) {
		DataResult<Map<String,List<Map<String, Object>>>> result = new DataResult<Map<String,List<Map<String, Object>>>>();
		try {
			List<Map<String, Object>> userList = userMapper.getUserMainPage(id);		//该用户的所有视频 
			List<Map<String, Object>> allUserList = userMapper.getMoreVideosFromUser(id);		//全部用户的所有视频 
			Map<String,List<Map<String, Object>>> map = new HashMap<String, List<Map<String,Object>>>();
			map.put("userList", userList);
			map.put("allUserList", allUserList);
			result.setCode("200");
			result.setData(map);
			result.setMessage("成功");
			result.setSuccess(true);
		}catch(Exception e) {
			result.setCode("500");
			result.setMessage("参数错误获取失败");
			result.setSuccess(false);
		}
		return result;
	}
	
