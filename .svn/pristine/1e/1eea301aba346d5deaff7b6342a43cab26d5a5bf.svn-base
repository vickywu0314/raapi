package com.car.jl.util;

import java.io.File;
import java.io.FileInputStream;
import java.io.FileNotFoundException;
import java.io.FileOutputStream;
import java.io.IOException;
import java.io.InputStream;
import java.io.OutputStream;
import java.math.BigDecimal;
import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.HashMap;
import java.util.Iterator;
import java.util.List;
import java.util.Map;

import javax.servlet.http.HttpServletResponse;

import org.jxls.common.Context;
import org.jxls.expression.JexlExpressionEvaluator;
import org.jxls.transform.Transformer;
import org.jxls.transform.poi.PoiTransformer;
import org.jxls.util.JxlsHelper;

import jxl.Workbook;
import jxl.WorkbookSettings;
import jxl.write.Label;
import jxl.write.WritableSheet;
import jxl.write.WritableWorkbook;
import jxl.write.WriteException;
import jxl.write.Number;
import jxl.write.WritableCellFormat;
import jxl.write.Boolean;

/**
 * @author klguang
 */
public class JxlsUtils{
	
	public void writeExcelFromTemplate(String outPath,String templatePath,List<Map<String,Object>> list,HttpServletResponse response) throws Exception
	{
		 // 表格要导出的目录
        FileOutputStream is = new FileOutputStream(outPath);
        // 读取模板文件
        Workbook wb = Workbook.getWorkbook(new File(templatePath));

        // 根据模板文件创建可写的文件，注意这里是createWorkbook(),创建而不是获取
        WorkbookSettings settings = new WorkbookSettings ();
        settings.setWriteAccess(null);
        WritableWorkbook wwb = Workbook.createWorkbook(is, wb,settings);
        // 注意这里是getSheet(), 通过索引，获取模板文件中的sheet页第一页
        WritableSheet sheet = wwb.getSheet(0);

        if(null != list && list.size() > 0 )
        {
        	int i = 1;
        	Iterator<Map<String,Object>> iter = list.iterator();
        	while(iter.hasNext())
        	{
        		Map<String,Object> one = iter.next();
        		Label label1 = new Label(0, i, one.get("id").toString());
        		Label label2 = new Label(1, i, one.get("name").toString());
        		Label label3 = new Label(2, i, one.get("phone").toString());
        		Label label4 = new Label(3, i,one.get("industry").toString());
        		Label label5 = new Label(4, i, one.get("province").toString());
        		Label label6 = new Label(5, i, one.get("city").toString());
        		Label label7 = new Label(6, i, one.get("invitation_code").toString());
        		Label label8 = new Label(7, i, one.get("have_car_type").toString());
        		Label label9 = new Label(8, i, one.get("source").toString());
        		Label label10 = new Label(9, i, one.get("source_code")==null ? "-":one.get("source_code").toString());
        		Label label11 = new Label(10, i, one.get("drive_img_url").toString());
        		Label label12 = new Label(11, i,one.get("create_time").toString());
        		Label label13 = new Label(12, i, one.get("qrcode_name").toString());
        		sheet.addCell(label1);
                sheet.addCell(label2);
                sheet.addCell(label3);
                sheet.addCell(label4);
                sheet.addCell(label5);
                sheet.addCell(label6);
                sheet.addCell(label7);
                sheet.addCell(label8);
                sheet.addCell(label9);
                sheet.addCell(label10);
                sheet.addCell(label11);
                sheet.addCell(label12);
                sheet.addCell(label13);
                i++;
        	}
        }
        try {
            wwb.write();
            wwb.close();
        } catch (IOException e) {
            e.printStackTrace();
        } catch (WriteException e) {
            e.printStackTrace();
        }
	}
    
}