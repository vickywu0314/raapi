<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.car.jl.mapper.LoginMapper" >

	<select id="getInvitationCodes" resultType="String" >
		select invitation_code from user
	</select>
	<select id="checkPhoneExist" resultType="String" >
		select phone from user
	</select>
	<insert id="saveUser" parameterType="com.car.jl.vo.User">
        <selectKey keyProperty="id" resultType="long" order="AFTER">
            SELECT LAST_INSERT_ID() AS id
        </selectKey>
        insert into user
        (name,phone,password,province,city,industry,invitation_code,have_car_type,source,source_code,drive_img_url,create_time)
        values
        (#{name},#{phone},#{password},#{province},#{city},#{industry},#{invitation_code},#{have_car_type},#{source},#{source_code},#{drive_img_url},now()})
    </insert>
	<select id="getUser" resultType="com.car.jl.vo.User" parameterType="Map">
		select * from user where phone=#{phone} and password=#{password}
	</select>
	<select id="getUserById" resultType="com.car.jl.vo.User" parameterType="Long">
		select * from user where id=#{id}
	</select>
	<select id="getUserByCode" resultType="com.car.jl.vo.User" parameterType="String">
		select * from user where invitation_code=#{code}
	</select>
	<insert id="saveUserMedia" parameterType="List">
		insert into user_media (user_id,url,type,create_time) values
		<foreach item="item" collection="list" separator="," close=";"> 
        	(#{item.user_id},#{item.url},#{item.type},now())   
        </foreach>
    </insert>
    <delete id="delUserMedia" parameterType="com.car.jl.vo.UserMedia">
    	delete from user_media where user_id=#{user_id} and url=#{url}
    </delete>
    <update id="updateIndustry" parameterType="com.car.jl.vo.User">
    	update user set industry=#{industry} where id=#{id}
    </update>
     <update id="updateUserQrcode" parameterType="com.car.jl.vo.User">
    	update user set qrcode_name=#{qrcode_name} where id=#{id}
    </update>
</mapper>