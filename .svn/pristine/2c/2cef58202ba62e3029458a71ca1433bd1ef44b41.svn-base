package com.car.jl.util;


import com.alibaba.fastjson.JSONObject;

import java.util.HashMap;
import java.util.Map;

import com.car.jl.util.WeiXinConstant;

public class WeinXinUtil  {
	
//	wechat分享的
	public static Map<String,Object> wxMap = new HashMap<String,Object>();
	
    public static WinXinEntity getWinXinEntity(String url) {
        WinXinEntity wx = new WinXinEntity();
        String accessToken = "";   
        String ticket ="";
        long currentTimeStamp = System.currentTimeMillis();
        System.out.println("准备分享。。。。");
        

        if(wxMap.get("timeStamp") != null)
        {
        	long beforeTimeStamp = (Long)wxMap.get("timeStamp");
    		System.out.println("准备分享1。。。。");
          	if((currentTimeStamp - beforeTimeStamp) /1000 < 7200)
          	{
          		accessToken = (String)wxMap.get("accessToken");
        		ticket = (String)wxMap.get("ticket");
        		System.out.println("老的access--->"+accessToken);
        		System.out.println("老的ticket--->"+ticket);
          	}else {
          		 accessToken = getAccessToken();
        		 ticket = getTicket(accessToken);
        		 wxMap.put("timeStamp", System.currentTimeMillis());
        		 wxMap.put("accessToken", accessToken);
        		 wxMap.put("ticket", ticket);
        		 System.out.println("超时了，还是拿新的access--->"+accessToken);
        		 System.out.println("超时了，还是拿新的ticket--->"+ticket);
          	}
        }else {
        	 accessToken = getAccessToken();
    		 ticket = getTicket(accessToken);
    		 wxMap.put("timeStamp", System.currentTimeMillis());
    		 wxMap.put("accessToken", accessToken);
    		 wxMap.put("ticket", ticket);
    		 System.out.println("创建新的access--->"+accessToken);
    		 System.out.println("创建新的ticket--->"+ticket);
        }
        
        
//        String accessToken = getAccessToken();
//        String ticket = getTicket(accessToken);
        Map<String, String> ret = Sign.sign(ticket, url);
        wx.setAccess_token(accessToken);
        wx.setTicket(ret.get("jsapi_ticket"));
        wx.setSignature(ret.get("signature"));
        wx.setNoncestr(ret.get("nonceStr"));
        wx.setTimestamp(ret.get("timestamp"));
        wx.setAppId(WeiXinConstant.WX_APP_ID);
        return wx;
    }

    //��ȡtoken
    private static String getAccessToken() {
        String accessToken = "";

        //���url���ӵ�ַ�Ͳ����Բ��ܱ�
        StringBuilder sb = new StringBuilder(WeiXinConstant.WX_SHARE_TOKEN_URL);
        sb.append("grant_type=client_credential");
        sb.append("&appid=");
        sb.append(WeiXinConstant.WX_APP_ID);
        sb.append("&secret=");
        sb.append(WeiXinConstant.WX_APP_SECRET);

        try {
            String result = HttpClientUtils.get(sb.toString(), "UTF-8");
            JSONObject demoJson = JSONObject.parseObject(result);
            accessToken = demoJson.getString("access_token");
        } catch (Exception e) {
            e.printStackTrace();
        }
        return accessToken;
    }

    //��ȡticket
    private static String getTicket(String accessToken) {
        String ticket = null;

        StringBuilder sb = new StringBuilder(WeiXinConstant.WX_SHARE_TICKET_URL);
        sb.append("access_token=");
        sb.append(accessToken);
        sb.append("&type=jsapi");
        try {
            String result = HttpClientUtils.get(sb.toString(), "UTF-8");
            JSONObject demoJson = JSONObject.parseObject(result);
            ticket = demoJson.getString("ticket");
        } catch (Exception e) {
            e.printStackTrace();
        }
        return ticket;
    }

